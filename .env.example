# --- Strava (legacy ingestion source) ---
# Standard-tier API access requires a paid Strava subscription as of 2026-06-30.
# Without one the API returns 403 Application/Status/Inactive.
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REFRESH_TOKEN=your_refresh_token_here

# --- intervals.icu (candidate ingestion source, bridges Garmin) ---
# Generate the key at https://intervals.icu/settings under "Developer Settings".
# Leave the athlete id as 0 to mean "whoever owns the key".
# Verify with: node dist/index.js probe-intervals
INTERVALS_API_KEY=your_intervals_api_key_here
INTERVALS_ATHLETE_ID=0
