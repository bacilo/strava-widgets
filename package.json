{
  "name": "strava-analytics",
  "version": "1.0.0",
  "description": "Strava activity analytics and visualization",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "sync": "node dist/index.js sync",
    "auth": "node dist/index.js auth",
    "compute-stats": "node dist/index.js compute-stats",
    "compute-advanced-stats": "node dist/index.js compute-advanced-stats",
    "compute-geo-stats": "node dist/index.js compute-geo-stats",
    "compute-best-efforts": "node dist/index.js compute-best-efforts",
    "compute-dashboard-index": "node dist/index.js compute-dashboard-index",
    "compute-training-load": "node dist/index.js compute-training-load",
    "compute-age-grading": "node dist/index.js compute-age-grading",
    "compute-gear-aggregate": "node dist/index.js compute-gear-aggregate",
    "compute-all-stats": "node dist/index.js compute-all-stats",
    "compute-route-data": "node scripts/compute-route-data.mjs",
    "compute-heatmap-data": "node scripts/compute-heatmap-data.mjs",
    "build-widget": "vite build",
    "build-widgets": "node scripts/build-widgets.mjs",
    "verify-dashboard": "node scripts/verify-dashboard-publish.mjs",
    "compare-geocoding": "node scripts/compare-geocoding.mjs",
    "fetch": "npm run build && node dist/index.js sync-intervals",
    "backfill-streams": "npm run build && node dist/index.js backfill-streams",
    "fetch-strava": "npm run build && node dist/index.js sync",
    "process": "npm run build && node dist/index.js compute-all-stats",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@garmin/fitsdk": "^21.212.0",
    "@mapbox/polyline": "^1.2.1",
    "bottleneck": "^2.19.5",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "dotenv": "^17.3.1",
    "hammerjs": "^2.0.8",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "offline-geocoder": "^1.0.0",
    "p-retry": "^7.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.3",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^4.0.18"
  }
}
