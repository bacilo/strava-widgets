node_modules/
dist/*
!dist/widgets/
dist/widgets/*
# index.html was removed from this exception list in Phase 16 because the
# dashboard SPA now generates it (build-widgets.mjs buildDashboard()).
!dist/widgets/test.html
.env
data/tokens.json
.DS_Store
data/stats/
# Dashboard activity index manifest: regenerated compute-step output, same
# convention as data/stats/ (D-12).
data/dashboard/
# Raw bulk exports (Strava/Garmin): full-resolution GPS+HR streams, too large
# and too sensitive for a public repo. data/provenance.json indexes into them.
export_data/
# Hand-maintained identity/health inputs (birthDate, sex, restingHr) for
# age-grading and TRIMP training load (Phase 18). This repo is PUBLIC —
# these fields must never enter git history. The example template is the
# one exception: it ships with placeholder-only values (T-18-PII-02).
data/private/*.json
!data/private/athlete-private.example.json
# Raw downloaded WMA age-grading source artifacts (xlsx/html) that
# scripts/convert-wma-tables.mjs parses into the committed data/wma/*.json
# tables. Not committed themselves — re-download to re-run the converter.
scripts/wma-source/
# Local curation mode's overlay bundle (esbuild output, Phase 24). Never an
# input to vite.config.pages.ts or build-widgets.mjs — keeping it out of git
# is half of D-01's structural-absence guarantee for the write path.
.curate-dist/
# scripts/first-paint-capture.mjs's raw PNG frames and per-run report.json
# (GAP-25-01, Phase 25 plan 25-08). Instrumentation evidence referenced by
# path from 25-VALIDATION.md, not committed — same convention as dist/data
# build scratch, kept out of git to avoid bloating history with screencast
# frame binaries. Re-runnable via `node scripts/first-paint-capture.mjs`.
.planning/phases/25-ci-hardening-light-theme-verification/capture/
